# ============================================================
# SS SPARK — Backend Environment Variables Template
# ============================================================

# ── Database ────────────────────────────────────────────────
# Local MongoDB: mongodb://localhost:27017
# Production MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ss_spark?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ss_spark

# ── Security & Authentication ───────────────────────────────
# Generate a strong random 64-character secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Frontend URL (for CORS & Email Links) ────────────────────
FRONTEND_URL=http://localhost:8080

# ── AI / LLM Providers (Provide at least one) ───────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Vector Database Configuration ───────────────────────────
# Set USE_QDRANT=false to use embedded ChromaDB
USE_QDRANT=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ss_spark_chunks

# ── Google OAuth 2.0 (Optional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (Optional) ──────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── SMTP Email (Optional for verification & password reset) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ssspark.ai

# ── Server Configuration ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
