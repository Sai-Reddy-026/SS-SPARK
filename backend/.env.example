# ============================================================
# SS SPARK — Backend Environment Variables Template
# ============================================================

# ── Database ────────────────────────────────────────────────
# Local MongoDB: mongodb://localhost:27017
# Production MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ss_spark?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ss_spark

# ── Security & Authentication ───────────────────────────────
# Generate a strong random 64-character secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Frontend URL (for CORS & Email Links) ────────────────────
FRONTEND_URL=http://localhost:8080

# ── AI / LLM Providers (Provide at least one) ───────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Vector Database Configuration ───────────────────────────
# Set USE_QDRANT=false to use embedded ChromaDB
USE_QDRANT=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ss_spark_chunks

# ── Google OAuth 2.0 (Optional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (Optional) ──────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email Delivery (Password Reset & Verification) ──────────
# Option 1: Resend.com API (Recommended — Works with Gmail, Outlook, Yahoo, etc.)
# Get a free API key at https://resend.com (3,000 free emails/month)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=onboarding@resend.dev  # or noreply@yourdomain.com with custom domain

# Option 2: SMTP (e.g. Gmail App Password, Outlook, SendGrid SMTP)
# For Gmail: Enable 2-Step Verification -> Generate App Password
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-16-character-app-password
# EMAIL_FROM=youraccount@gmail.com

# Option 3: Development fallback (logs reset link to console, no real send)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@ssspark.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ── Server Configuration ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
