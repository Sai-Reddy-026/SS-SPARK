# ============================================================
# SS SPARK — Master Environment Variables Template (.env.example)
# Copy this file to .env and fill in your values.
# ============================================================

# ── Frontend Settings ───────────────────────────────────────
# Local Development: http://localhost:8000
# Production: https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:8000

# ── Database ────────────────────────────────────────────────
# Local MongoDB: mongodb://localhost:27017
# Production Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ss_spark?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ss_spark

# ── Security & Authentication ───────────────────────────────
# Generate a strong random 64-character secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Frontend URL (for CORS & Email Links) ────────────────────
FRONTEND_URL=https://ss-spark.vercel.app

# ── AI / LLM Providers ──────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=

# ── AI Provider Router — Secondary keys for rotation (optional) ──────────────
# If you have multiple keys for the same provider, add them here.
# The router will cycle through them automatically.
GEMINI_API_KEY_2=
OPENAI_API_KEY_2=
NVIDIA_API_KEY_2=
OPENROUTER_API_KEY_2=

# ── AI Provider Router — Routing behaviour ───────────────────────────────────
# fast  = lowest latency first, sequential fallback (DEFAULT — recommended for 5 users)
# race  = fire all providers simultaneously, use first response (uses more quota)
AI_ROUTING_MODE=fast
# Seconds before first token before trying next provider
AI_REQUEST_TIMEOUT_SECONDS=8
# Cooldown in seconds after a provider rate-limit or failure
AI_PROVIDER_COOLDOWN_SECONDS=30

# ── AI Provider Router — Model overrides (leave blank to use defaults) ────────
GEMINI_MODEL=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_MODEL=
OPENROUTER_MODEL=

# ── AI Provider Router — 4th / Custom provider (OpenAI-compatible) ────────────
# Fill all three to enable a 4th provider (e.g. Groq, Together, Mistral, etc.)
# Leave blank if you only have 3 providers.
CUSTOM_PROVIDER_NAME=
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_MODEL=

# ── Vector Database Configuration ───────────────────────────
# Set USE_QDRANT=false to use embedded ChromaDB
USE_QDRANT=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ss_spark_chunks

# ── Google OAuth 2.0 (Optional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (Optional) ──────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email Delivery (Password Reset & Verification) ──────────
# Option 1: Resend.com (EMAIL_PROVIDER=resend)
# Option 2: SMTP (EMAIL_PROVIDER=smtp)
# Option 3: Development console log fallback (EMAIL_PROVIDER=log or empty)
EMAIL_PROVIDER=
EMAIL_FROM=noreply@ssspark.ai
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Server Configuration ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
